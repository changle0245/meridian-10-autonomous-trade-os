# Safe public-lab defaults. Switch to `database` only after the managed resources
# below are connected in Vercel; database mode fails closed if any are missing.
DATA_MODE=fixture
AUTH_MODE=demo
OUTBOUND_MODE=draft

# Managed Neon Postgres (server-only).
DATABASE_URL=

# Managed Clerk authentication. Never expose the secret key to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# 32+ character server-only secret for deterministic, retry-safe portal links.
# The database stores only a SHA-256 hash of each derived token.
PORTAL_TOKEN_SECRET=

# Optional one-time deterministic seed identity mapping (never required at runtime).
SEED_CLERK_ORGANIZATION_ID=
SEED_CLERK_USER_ID=
SEED_PORTAL_TOKEN=

# Vercel Blob is used for immutable issued-document versions.
BLOB_READ_WRITE_TOKEN=

# Vercel Cron sends this value as `Authorization: Bearer <secret>`.
CRON_SECRET=
